PORT=8001
# Must match docker-compose MONGO_PASSWORD; URL-encode special chars (# → %23)
MONGO_PASSWORD=cloudlane
DATABASE_URL=mongodb://cloudlane:cloudlane@localhost:27017/cloudlane?authSource=admin
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440
BASE_DOMAIN=cloudlane.run
KUBECONFIG=
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=cloudlane
MINIO_SECRET_KEY=cloudlane-secret
REDIS_URL=redis://localhost:6380/0
GATEWAY_BASE_DOMAIN=gateway.cloudlane.run
LB_BASE_DOMAIN=lb.cloudlane.run
LB_CONFIG_DIR=infra/nginx/lbs
# Managed SQL (tenant product) — docker compose managed-postgres / managed-mysql
MANAGED_POSTGRES_HOST=localhost
MANAGED_POSTGRES_PORT=5433
MANAGED_POSTGRES_ADMIN_USER=cloudlane_rds
MANAGED_POSTGRES_ADMIN_PASSWORD=cloudlane-rds
MANAGED_MYSQL_HOST=localhost
MANAGED_MYSQL_PORT=3307
MANAGED_MYSQL_ADMIN_USER=root
MANAGED_MYSQL_ADMIN_PASSWORD=cloudlane-rds
WORKER_POLL_INTERVAL=2
PROVISION_MAX_ATTEMPTS=3
# Data encryption — set ENVIRONMENT=production on Netlify; forces Mongo TLS + HSTS
ENVIRONMENT=development
FORCE_HTTPS=false
MONGO_TLS_REQUIRED=false
# Optional — Fernet root of trust for tenant + ops vaults (falls back to JWT_SECRET)
SECRETS_MASTER_KEY=
# DATABASE_URL must stay in env (bootstrap). After migrate, JWT/MinIO/Redis/IremboPay
# can live in Mongo system_secrets via POST /api/ops/secrets/migrate (admin).
# Production Atlas: use mongodb+srv://… (TLS built-in) or mongodb://…?tls=true
IREMBOPAY_API_KEY=
IREMBOPAY_API_URL=https://api.irembopay.com
