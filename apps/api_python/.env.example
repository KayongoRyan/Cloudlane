PORT=8001
# Must match docker-compose MONGO_PASSWORD; URL-encode special chars (# → %23)
MONGO_PASSWORD=cloudlane
DATABASE_URL=mongodb://cloudlane:cloudlane@localhost:27017/cloudlane?authSource=admin
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440
BASE_DOMAIN=cloudlane.run
KUBECONFIG=
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=cloudlane
MINIO_SECRET_KEY=cloudlane-secret
REDIS_URL=redis://localhost:6380/0
GATEWAY_BASE_DOMAIN=gateway.cloudlane.run
WORKER_POLL_INTERVAL=2
PROVISION_MAX_ATTEMPTS=3
IREMBOPAY_API_KEY=
IREMBOPAY_API_URL=https://api.irembopay.com
