```
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
.next/
.nuxt/
out/

# TypeScript
*.tsbuildinfo
*.js.map
*.ts.map

# Environment
.env
.env.local
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache directories
.cache/
.tmp/
.temp/
.npm-cache/

# Coverage
coverage/
.nyc_output/

# Local database data (never commit)
.postgres/
*.pid

# Generated nginx edge configs
infra/nginx/lbs/*.conf
!infra/nginx/lbs/.gitkeep
```
