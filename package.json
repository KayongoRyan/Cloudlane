{
  "name": "cloudlane",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant cloud platform with Cloud Run-style deploy experience",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"cd apps/api_python && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8001\" \"cd apps/dashboard && npm run dev\"",
    "dev:api": "cd apps/api_python && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "dev:dashboard": "cd apps/dashboard && npm run dev",
    "build": "cd apps/dashboard && npm run build",
    "test": "cd apps/dashboard && npm run test",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0"
  }
}